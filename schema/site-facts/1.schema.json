{
  "$defs": {
    "date": {
      "format": "date",
      "type": "string"
    },
    "member": {
      "additionalProperties": false,
      "properties": {
        "mark": {
          "description": "the organisation's own mark, a file under web/ given with its permission; the pages print the name until a mark is drawn",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.(svg|png)$",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "precision_words": {
          "additionalProperties": {
            "$ref": "#/$defs/text"
          },
          "description": "workload precision id -> its plain words",
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "organisation": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "type": "object"
    },
    "row": {
      "additionalProperties": false,
      "dependentRequired": {
        "reason_source": [
          "reason"
        ]
      },
      "properties": {
        "code": {
          "enum": [
            "open_licence",
            "restricted_licence",
            "no_licence_file",
            "no_public_code"
          ]
        },
        "generation": {
          "$comment": "how the system generates its replies where it does so in a phase of its own (RFC-0018 AD-4), the cause line under Cost (CO-7, amended 2026-11-15)",
          "additionalProperties": false,
          "properties": {
            "quote": {
              "$ref": "#/$defs/text",
              "description": "the publisher's words that state it, verbatim"
            },
            "url": {
              "$ref": "#/$defs/url"
            },
            "words": {
              "$ref": "#/$defs/text",
              "description": "the engine and how it generates, in plain words"
            }
          },
          "required": [
            "words",
            "quote",
            "url"
          ],
          "type": "object"
        },
        "kind_words": {
          "$ref": "#/$defs/text",
          "description": "a reference row's role, in plain words (RFC-0015)"
        },
        "licence": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "url": {
              "$ref": "#/$defs/url"
            }
          },
          "required": [
            "name",
            "url"
          ],
          "type": "object"
        },
        "models": {
          "description": "the models the system's sources name, as they name them",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "overview_workload": {
          "description": "the workload id of the system's one row on the overview, when it runs more than one (owner decision, RFC-0009 S6)",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "paper": {
          "$comment": "the publisher's paper, linked at the row's pinned commit (a file of its repository there), where the repository carries one; absent otherwise, and nothing is printed for it (2026-11-16)",
          "$ref": "#/$defs/url"
        },
        "pin": {
          "$comment": "where the row's version is not the publisher's own: the change it runs, printed in the band at depth 2 (RFC-0018 SI-3, amended 2026-11-15)",
          "additionalProperties": false,
          "properties": {
            "by_owner": {
              "description": "written by this project's owner",
              "type": "boolean"
            },
            "merged": {
              "type": "boolean"
            },
            "pull": {
              "description": "the pull request's number in the publisher's repository",
              "minimum": 1,
              "type": "integer"
            },
            "record": {
              "description": "the record of that outcome, a path in the repository",
              "pattern": "^results/[A-Za-z0-9/_.-]+$",
              "type": "string"
            },
            "upstream_commit": {
              "description": "the publisher's own commit the row would run without the change",
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "upstream_outcome": {
              "$ref": "#/$defs/text",
              "description": "what the publisher's own commit did on the level's request, in plain words"
            },
            "url": {
              "$ref": "#/$defs/url"
            }
          },
          "required": [
            "pull",
            "url",
            "merged",
            "by_owner",
            "upstream_commit",
            "upstream_outcome"
          ],
          "type": "object"
        },
        "reason": {
          "description": "RFC-0018 SI-4: the one fixed reason a system has no row on the board",
          "enum": [
            "a different statement",
            "licence",
            "no public verifier",
            "no configuration at the request",
            "another kind of check",
            "not yet run"
          ]
        },
        "reason_source": {
          "additionalProperties": false,
          "description": "RFC-0018 SI-4b: the fact that sets `reason`, in words (a quoted phrase is the publisher's own), and the link where it is read",
          "properties": {
            "url": {
              "$ref": "#/$defs/url"
            },
            "words": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "url",
            "words"
          ],
          "type": "object"
        },
        "status": {
          "additionalProperties": false,
          "dependentRequired": {
            "last_push": [
              "source",
              "retrieved"
            ]
          },
          "properties": {
            "last_push": {
              "$ref": "#/$defs/date"
            },
            "quote": {
              "$ref": "#/$defs/text",
              "description": "the system's own words for its status, verbatim"
            },
            "retrieved": {
              "$ref": "#/$defs/date"
            },
            "source": {
              "$ref": "#/$defs/text"
            },
            "state": {
              "enum": [
                "active",
                "unmaintained",
                "archived",
                "no_repository"
              ]
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        "technique": {
          "$ref": "#/$defs/text",
          "description": "how the system proves, attests or checks, in the words of its own sources; absent when they do not state it"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "text": {
      "minLength": 1,
      "type": "string"
    },
    "url": {
      "format": "uri",
      "pattern": "^https://",
      "type": "string"
    }
  },
  "$id": "https://inference-proofs.org/schema/site-facts/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credit": {
      "additionalProperties": false,
      "description": "who builds the site, printed in every page's footer, and its members, each listed once it has given its agreement",
      "properties": {
        "builder": {
          "$ref": "#/$defs/organisation",
          "description": "the group that builds the site"
        },
        "lead": {
          "$ref": "#/$defs/organisation",
          "description": "the organisation that leads it"
        },
        "members": {
          "description": "the member organisations, in the order printed",
          "items": {
            "$ref": "#/$defs/member"
          },
          "maxItems": 12,
          "type": "array"
        }
      },
      "required": [
        "builder",
        "lead",
        "members"
      ],
      "type": "object"
    },
    "gpus": {
      "additionalProperties": {
        "$ref": "#/$defs/text"
      },
      "description": "reference file profile GPU model -> the short name the pages print",
      "minProperties": 1,
      "type": "object"
    },
    "models": {
      "additionalProperties": {
        "$ref": "#/$defs/model"
      },
      "description": "workload model digest -> its display name and precision words",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "type": "object"
    },
    "rows": {
      "additionalProperties": {
        "$ref": "#/$defs/row"
      },
      "description": "criteria row id -> the facts printed for that row",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "type": "object"
    },
    "schema": {
      "const": "site-facts/1"
    },
    "site": {
      "additionalProperties": false,
      "properties": {
        "licence": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "licence"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "site",
    "credit",
    "gpus",
    "models",
    "rows"
  ],
  "title": "Display facts the site prints and no harness record holds: web/_data/facts.json (RFC-0009 §Site). Every value is text.",
  "type": "object"
}
